{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "references": [
    {
      "path": "../compiler"
    },
    {
      "path": "../config"
    },
    {
      "path": "../desktop"
    },
    {
      "path": "../registry"
    },
    {
      "path": "../deploy"
    }
  ],
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
