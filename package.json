{
  "name": "onestack",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "desktop:check": "cargo check --manifest-path packages/desktop/native/Cargo.toml",
    "desktop:build": "cargo build --release --manifest-path packages/desktop/native/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
